              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Corpo é um array\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/items — válido",
          "request": {
            "method": "POST",
            "header": [
