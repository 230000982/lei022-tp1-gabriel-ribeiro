{
  "info": {
    "name": "LEI022 TP1 — API REST (items e books)",
    "description": "Executar com a API a correr em {{baseUrl}}. Correr a coleção inteira, pela ordem (Collection Runner).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code >= 400) {",
          "pm.test(\"Erro no formato único (problem+json com status, title, detail)\", function () {",
          "pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
          "const b = pm.response.json();",
          "pm.expect(b.status).to.eql(pm.response.code);",
          "pm.expect(b.title).to.be.a(\"string\");",
          "pm.expect(b.detail).to.be.a(\"string\");",
          "});",
          "}",
          "pm.test(\"Nunca devolve 500\", function () { pm.expect(pm.response.code).to.not.eql(500); });"
        ]
      }
    }
  ],
