            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"  Item de teste  \"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "",
                  "pm.test(\"Header Location correto\", function () {",
                  "const b = pm.response.json();",
                  "pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/items/\" + b.id);",
                  "});",
                  "pm.test(\"Nome guardado sem espaços exteriores\", function () {",
                  "const b = pm.response.json();",
                  "pm.expect(b.id).to.be.a(\"number\");",
                  "pm.expect(b.name).to.eql(\"Item de teste\");",
                  "pm.collectionVariables.set(\"itemId\", b.id);",
                  "});"
                ]
              }
            }
          ]
        },
